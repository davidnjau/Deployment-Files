NETWORK_NAME=service_network

# ── Vault ────────────────────────────────────────────────────────────────────
VAULT_IMAGE=hashicorp/vault:1.17.2
VAULT_PORT=8200
# Use the container-internal address inside the compose network
VAULT_ADDR=http://vault:8200

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-06-13T22-53-53Z
MINIO_CONTAINER_NAME=minio
MINIO_S3_PORT=9000
MINIO_WEB_PORT=9001
MINIO_ROOT_USER=           # REQUIRED — set before starting
MINIO_ROOT_PASSWORD=       # REQUIRED — min 8 chars

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_IMAGE=mongo:6.0.14
MONGODB_CONTAINER_NAME=mongodb
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=   # REQUIRED
MONGO_INITDB_ROOT_PASSWORD=   # REQUIRED
MONGO_INITDB_DATABASE=        # REQUIRED — initial database name

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_IMAGE=redis/redis-stack:7.4.0-v0
REDIS_CONTAINER_NAME=redis
REDIS_PORT=6379
REDIS_WEB_PORT=8004
REDIS_PASSWORD=               # REQUIRED

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=                # REQUIRED — avoid using 'postgres'
POSTGRES_PASSWORD=            # REQUIRED
POSTGRES_DB=app_db

# ── PgBouncer ─────────────────────────────────────────────────────────────────
# auth_user: a dedicated PostgreSQL role used by PgBouncer to look up passwords.
# It has no data access — only EXECUTE on pgbouncer.get_auth().
PGBOUNCER_AUTH_USER=pgbouncer
PGBOUNCER_AUTH_PASSWORD=      # REQUIRED — used in userlist.txt (generated at runtime)
PGBOUNCER_PORT=6432           # Host port for application connections

# ── Backup ────────────────────────────────────────────────────────────────────
# Cron schedule for pg_dump (default: daily at 02:00 UTC)
BACKUP_SCHEDULE=0 2 * * *
# Number of most-recent backups to keep; older ones are deleted automatically
BACKUP_KEEP_DAYS=7

# ── PgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=        # REQUIRED — e.g. admin@yourcompany.com
PGADMIN_DEFAULT_PASSWORD=     # REQUIRED

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_DB_PASSWORD=               # REQUIRED — postgres password for keycloak db
KEYCLOAK_ADMIN=               # REQUIRED — initial admin username
KEYCLOAK_ADMIN_PASSWORD=      # REQUIRED
KC_HOSTNAME=                  # REQUIRED — e.g. auth.yourcompany.com

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_ZOOKEEPER_PASSWORD=     # REQUIRED — shared zookeeper auth password
KAFKA_INTER_BROKER_USER=inter_broker
KAFKA_INTER_BROKER_PASSWORD=  # REQUIRED
KAFKA_CLIENT_USER=app
KAFKA_CLIENT_PASSWORD=        # REQUIRED
KAFKA_UI_USER=                # REQUIRED — kafka-ui login username
KAFKA_UI_PASSWORD=            # REQUIRED

# ── Superset ──────────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=          # REQUIRED — generate with: openssl rand -base64 42
SUPERSET_POSTGRES_USER=       # REQUIRED
SUPERSET_POSTGRES_PASSWORD=   # REQUIRED
